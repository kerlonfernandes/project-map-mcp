{
  "name": "project-mapper-mcp",
  "version": "1.2.1",
  "description": "MCP server that maintains persistent, verifiable technical memory for software projects — indexes structure, tracks relationships, stores knowledge with evidence, and delivers progressive context to AI clients",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pmap": "dist/cli/index.js",
    "project-mapper-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "migrations/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerlonfernandes/project-map-mcp.git"
  },
  "homepage": "https://github.com/kerlonfernandes/project-map-mcp#readme",
  "bugs": {
    "url": "https://github.com/kerlonfernandes/project-map-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "clean": "rm -rf dist/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "code-intelligence",
    "project-analysis",
    "tree-sitter",
    "knowledge-graph",
    "codebase-memory",
    "ai-agent",
    "claude",
    "cursor",
    "code-context",
    "architecture",
    "laravel",
    "express",
    "php",
    "javascript"
  ],
  "author": "Kerlon Santana Fernandes",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.1.1",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.14",
    "mysql2": "^3.24.6",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-php": "^0.23.12",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "tree-sitter-python@0.25.0": true,
    "tree-sitter-typescript@0.23.2": true
  }
}
